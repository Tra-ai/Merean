{
  "writing-tips": {
    "title": "\u1782\u1793\u17d2\u179b\u17b9\u17c7\u178f\u17c2\u1784\u179f\u17c1\u1785\u1780\u17d2\u178f\u17b8",
    "description": "\u1782\u1793\u17d2\u179b\u17b9\u17c7\u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb\u179a\u17c0\u1794\u1785\u17c6 \u1793\u17b7\u1784\u179f\u179a\u179f\u17c1\u179a\u178f\u17c2\u1784\u179f\u17c1\u1785\u1780\u17d2\u178f\u17b8\u17b1\u17d2\u1799\u1794\u17b6\u1793\u1785\u17d2\u1794\u17b6\u179f\u17cb\u179b\u17b6\u179f\u17cb\u17d4",
    "sections": [
      {
        "title": "\u17e1. \u179f\u17d2\u179c\u17c2\u1784\u1799\u179b\u17cb\u1794\u17d2\u179a\u1792\u17b6\u1793\u1794\u1791",
        "text": "\u17a2\u17b6\u1793\u1794\u17d2\u179a\u1792\u17b6\u1793\u1794\u1791\u178a\u17c4\u1799\u1799\u1780\u1785\u17b7\u178f\u17d2\u178f\u1791\u17bb\u1780\u178a\u17b6\u1780\u17cb\u17d4 \u1780\u17c6\u178e\u178f\u17cb\u1796\u17b6\u1780\u17d2\u1799\u1782\u1793\u17d2\u179b\u17b9\u17c7 \u1793\u17b7\u1784\u1782\u17c6\u1793\u17b7\u178f\u179f\u17c6\u1781\u17b6\u1793\u17cb\u178a\u17c2\u179b\u178f\u17d2\u179a\u17bc\u179c\u1796\u1793\u17d2\u1799\u179b\u17cb \u17ac\u1796\u17b7\u1797\u17b6\u1780\u17d2\u179f\u17b6\u17d4"
      },
      {
        "title": "\u17e2. \u179a\u17c0\u1794\u1785\u17c6\u1782\u17c6\u1793\u17b7\u178f",
        "text": "\u179a\u17c0\u1794\u1785\u17c6\u1782\u1798\u17d2\u179a\u17c4\u1784\u1798\u17bb\u1793\u179f\u179a\u179f\u17c1\u179a\u17d4 \u1787\u17d2\u179a\u17be\u179f\u179a\u17be\u179f\u17a2\u17c6\u178e\u17c7\u17a2\u17c6\u178e\u17b6\u1784 \u1793\u17b7\u1784\u17a7\u1791\u17b6\u17a0\u179a\u178e\u17cd\u1796\u17b8\u179a\u17bf\u1784\u17a2\u1780\u17d2\u179f\u179a\u179f\u17b7\u179b\u17d2\u1794\u17cd \u178a\u17be\u1798\u17d2\u1794\u17b8\u1782\u17b6\u17c6\u1791\u17d2\u179a\u1782\u17c6\u1793\u17b7\u178f\u1793\u17b8\u1798\u17bd\u1799\u17d7\u17d4"
      },
      {
        "title": "\u17e3. \u1796\u17b7\u1793\u17b7\u178f\u17d2\u1799\u17a1\u17be\u1784\u179c\u17b7\u1789",
        "text": "\u17a2\u17b6\u1793\u17a2\u178f\u17d2\u1790\u1794\u1791\u179a\u1794\u179f\u17cb\u17a2\u17d2\u1793\u1780\u17a1\u17be\u1784\u179c\u17b7\u1789 \u178a\u17be\u1798\u17d2\u1794\u17b8\u1780\u17c2\u179f\u1798\u17d2\u179a\u17bd\u179b\u17a2\u1780\u17d2\u1781\u179a\u17b6\u179c\u17b7\u179a\u17bb\u1791\u17d2\u1792 \u1783\u17d2\u179b\u17b6\u1794\u17d2\u179a\u1799\u17c4\u1782 \u1793\u17b7\u1784\u179b\u17c6\u178a\u17b6\u1794\u17cb\u1782\u17c6\u1793\u17b7\u178f\u17d4"
      }
    ]
  },
  "essay-plans": {
    "title": "\u1782\u1798\u17d2\u179a\u17c4\u1784\u178f\u17c2\u1784\u179f\u17c1\u1785\u1780\u17d2\u178f\u17b8",
    "description": "\u1782\u1798\u17d2\u179a\u17c4\u1784\u1791\u17bc\u1791\u17c5\u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb\u1780\u17b6\u179a\u179f\u179a\u179f\u17c1\u179a\u178f\u17c2\u1784\u179f\u17c1\u1785\u1780\u17d2\u178f\u17b8\u17d4",
    "sections": [
      {
        "title": "\u17e1. \u179f\u17c1\u1785\u1780\u17d2\u178f\u17b8\u1795\u17d2\u178f\u17be\u1798",
        "text": "\u179b\u17c6\u1793\u17b6\u17c6\u1794\u1789\u17d2\u17a0\u17b6\u17d6 \u1794\u1784\u17d2\u17a0\u17b6\u1789\u1794\u179a\u17b7\u1794\u1791 \u1793\u17b7\u1784\u1797\u17d2\u1787\u17b6\u1794\u17cb\u1791\u17c5\u1794\u17d2\u179a\u1792\u17b6\u1793\u1794\u1791\u17d4\n\u1785\u17c6\u178e\u17bc\u179b\u1794\u1789\u17d2\u17a0\u17b6\u17d6 \u179b\u17be\u1780\u1794\u17d2\u179a\u1792\u17b6\u1793\u1794\u1791\u178a\u17c2\u179b\u178f\u17d2\u179a\u17bc\u179c\u1796\u17b7\u1797\u17b6\u1780\u17d2\u179f\u17b6\u17d4\n\u1785\u17c6\u178e\u17c4\u1791\u1794\u1789\u17d2\u17a0\u17b6\u17d6 \u178a\u17b6\u1780\u17cb\u179f\u17c6\u178e\u17bd\u179a\u178a\u17be\u1798\u17d2\u1794\u17b8\u1788\u17b6\u1793\u1791\u17c5\u1780\u17b6\u179a\u1794\u1780\u179f\u17d2\u179a\u17b6\u1799\u17d4"
      },
      {
        "title": "\u17e2. \u178f\u17bd\u179f\u17c1\u1785\u1780\u17d2\u178f\u17b8",
        "text": "\u1796\u1793\u17d2\u1799\u179b\u17cb\u1796\u17b6\u1780\u17d2\u1799\u1782\u1793\u17d2\u179b\u17b9\u17c7 \u1793\u17b7\u1784\u1793\u17d0\u1799\u1794\u17d2\u179a\u1792\u17b6\u1793\u1794\u1791\u17d4 \u1794\u1780\u179f\u17d2\u179a\u17b6\u1799\u17a2\u17c6\u178e\u17c7\u17a2\u17c6\u178e\u17b6\u1784\u1793\u17b8\u1798\u17bd\u1799\u17d7 \u178a\u17c4\u1799\u179b\u17be\u1780\u17a7\u1791\u17b6\u17a0\u179a\u178e\u17cd\u17b1\u17d2\u1799\u1794\u17b6\u1793\u1785\u17d2\u1794\u17b6\u179f\u17cb\u179b\u17b6\u179f\u17cb\u17d4"
      },
      {
        "title": "\u17e3. \u179f\u17c1\u1785\u1780\u17d2\u178f\u17b8\u1794\u1789\u17d2\u1785\u1794\u17cb",
        "text": "\u179f\u179a\u17bb\u1794\u1782\u17c6\u1793\u17b7\u178f\u179f\u17c6\u1781\u17b6\u1793\u17cb\u17d7 \u179c\u17b6\u1799\u178f\u1798\u17d2\u179b\u17c3\u179b\u17be\u1794\u17d2\u179a\u1792\u17b6\u1793\u1794\u1791 \u1793\u17b7\u1784\u1794\u1784\u17d2\u17a0\u17b6\u1789\u1798\u178f\u17b7\u1799\u17c4\u1794\u179b\u17cb\u178a\u17c2\u179b\u179f\u1798\u179f\u17d2\u179a\u1794\u17d4"
      }
    ]
  },
  "linking-words": {
    "title": "\u179f\u17c6\u1793\u17bd\u1793\u1796\u17b6\u1780\u17d2\u1799\u1797\u17d2\u1787\u17b6\u1794\u17cb",
    "description": "\u1796\u17b6\u1780\u17d2\u1799\u1797\u17d2\u1787\u17b6\u1794\u17cb\u1787\u17bd\u1799\u17b1\u17d2\u1799\u1783\u17d2\u179b\u17b6\u1794\u17d2\u179a\u1799\u17c4\u1782 \u1793\u17b7\u1784\u1782\u17c6\u1793\u17b7\u178f\u1798\u17b6\u1793\u1791\u17c6\u1793\u17b6\u1780\u17cb\u1791\u17c6\u1793\u1784\u1782\u17d2\u1793\u17b6\u17d4",
    "sections": [
      {
        "title": "\u1780\u17b6\u179a\u1794\u1793\u17d2\u1790\u17c2\u1798\u1782\u17c6\u1793\u17b7\u178f",
        "text": "\u179b\u17be\u179f\u1796\u17b8\u1793\u17c1\u17c7\u1791\u17c5\u1791\u17c0\u178f \u00b7 \u1798\u17d2\u1799\u17c9\u17b6\u1784\u179c\u17b7\u1789\u1791\u17c0\u178f \u00b7 \u1791\u1793\u17d2\u1791\u17b9\u1798\u1793\u17b9\u1784\u1793\u17c1\u17c7 \u00b7 \u1798\u17b7\u1793\u178f\u17c2\u1794\u17c9\u17bb\u178e\u17d2\u178e\u17c4\u17c7"
      },
      {
        "title": "\u1780\u17b6\u179a\u179b\u17be\u1780\u17a7\u1791\u17b6\u17a0\u179a\u178e\u17cd",
        "text": "\u17a7\u1791\u17b6\u17a0\u179a\u178e\u17cd \u00b7 \u1787\u17b6\u1780\u17cb\u179f\u17d2\u178f\u17c2\u1784 \u00b7 \u178a\u17bc\u1785\u1787\u17b6 \u00b7 \u178a\u17be\u1798\u17d2\u1794\u17b8\u1794\u1789\u17d2\u1787\u17b6\u1780\u17cb\u17b1\u17d2\u1799\u1780\u17b6\u1793\u17cb\u178f\u17c2\u1785\u17d2\u1794\u17b6\u179f\u17cb"
      },
      {
        "title": "\u1780\u17b6\u179a\u1794\u1784\u17d2\u17a0\u17b6\u1789\u1798\u178f\u17b7\u1795\u17d2\u1791\u17bb\u1799",
        "text": "\u1794\u17c9\u17bb\u1793\u17d2\u178f\u17c2 \u00b7 \u1791\u17c4\u17c7\u1787\u17b6\u1799\u17c9\u17b6\u1784\u178e\u17b6 \u00b7 \u1795\u17d2\u1791\u17bb\u1799\u1791\u17c5\u179c\u17b7\u1789 \u00b7 \u1790\u17d2\u179c\u17b8\u178f\u17d2\u1794\u17b7\u178f\u178f\u17c2"
      },
      {
        "title": "\u1780\u17b6\u179a\u179f\u1793\u17d2\u1793\u17b7\u178a\u17d2\u178b\u17b6\u1793",
        "text": "\u179f\u179a\u17bb\u1794\u179f\u17c1\u1785\u1780\u17d2\u178f\u17b8\u1798\u1780 \u00b7 \u178a\u17bc\u1785\u17d2\u1793\u17c1\u17c7 \u00b7 \u17a0\u17c1\u178f\u17bb\u1793\u17c1\u17c7\u17a0\u17be\u1799 \u00b7 \u178f\u17b6\u1798\u1780\u17b6\u179a\u1794\u1780\u179f\u17d2\u179a\u17b6\u1799\u1781\u17b6\u1784\u179b\u17be"
      }
    ]
  }
}