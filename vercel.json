{
  "rewrites": [
    {
      "source": "/((?!api/|audio/|data/|assets/|icons/|manifest\\.webmanifest$|favicon\\.ico$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/audio/(.*)\\.mp3",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/mpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/translate.js": {
      "maxDuration": 60
    }
  }
}